sform: uppercase;\n      margin-bottom: 12px;\n    }\n\n    .cert-heading-wrap {\n      display: inline-block;\n      position: relative;\n      padding: 0 20px;\n    }\n\n    .cert-title {\n      font-family: 'Cinzel', serif;\n      font-size: 25px;\n      font-weight: 700;\n      color: var(--primary-navy);\n      letter-spacing: 4px;\n      text-transform: uppercase;\n      display: inline-block;\n      border-bottom: 2px solid var(--gold-main);\n      padding-bottom: 4px;\n    }\n\n    /* Certificate Body */\n    .body-section {\n      text-align: center;\n      margin: 8px 0;\n      position: relative;\n      z-index: 2;\n    }\n\n    .presentation-line {\n      font-family: 'Playfair Display', serif;\n      font-style: italic;\n      font-size: 15px;\n      color: var(--accent-slate);\n      margin-bottom: 8px;\n    }\n\n    .recipient-name-block {\n      margin: 8px auto 6px auto;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .recipient-name {\n      font-family: 'Playfair Display', Georgia, serif;\n      font-size: 32px;\n      font-weight: 700;\n      color: var(--primary-navy);\n      min-width: 480px;\n      border-bottom: 1.5px solid var(--gold-main);\n      padding-bottom: 4px;\n      letter-spacing: 0.5px;\n      outline: none;\n    }\n\n    .recipient-role {\n      font-family: 'Cinzel', serif;\n      font-size: 15px;\n      font-weight: 700;\n      color: var(--gold-dark);\n      letter-spacing: 1.5px;\n      margin-top: 10px;\n      text-transform: uppercase;\n    }\n\n    .citation-text {\n      max-width: 820px;\n      margin: 10px auto 0 auto;\n      font-size: 12px;\n      line-height: 1.65;\n      color: #334155;\n      font-weight: 400;\n      text-align: center;\n    }\n\n    .citation-text strong {\n      color: var(--primary-navy);\n      font-weight: 600;\n    }\n\n    /* Details Metadata */\n    .meta-details {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      max-width: 900px;\n      width: 100%;\n      margin: 12px auto 18px auto;\n      font-size: 11.5px;\n      color: #334155;\n      font-weight: 500;\n      padding: 6px 16px;\n      background: rgba(255, 255, 255, 0.65);\n      border-radius: 6px;\n      border: 1px solid rgba(197, 155, 39, 0.25);\n    }\n\n    .meta-item {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      white-space: nowrap;\n    }\n\n    .meta-details b {\n      color: var(--primary-navy);\n      font-weight: 700;\n    }\n\n    /* Central Gold Seal */\n    .seal-wrap {\n      position: absolute;\n      bottom: 22px;\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      z-index: 3;\n      pointer-events: none;\n    }\n\n    .gold-seal-svg {\n      display: block;\n      filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.28));\n    }\n\n    /* Signatures Section */\n    .signatures-section {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      padding: 0 40px;\n      margin-top: 14px;\n      position: relative;\n      z-index: 2;\n    }\n\n    .signature-block {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      width: 250px;\n      text-align: center;\n    }\n\n    .sig-line {\n      width: 100%;\n      border-bottom: 1.5px solid #0f172a;\n      margin-bottom: 6px;\n    }\n\n    .sig-title {\n      font-family: 'Montserrat', sans-serif;\n      font-size: 12px;\n      font-weight: 700;\n      color: var(--primary-navy);\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    .sig-org {\n      font-size: 10.5px;\n      font-weight: 500;\n      color: #475569;\n      margin-top: 2px;\n    }\n\n    /* Subtle Center Watermark */\n    .watermark {\n      position: absolute;\n      top: 52%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      width: 320px;\n      height: 320px;\n      opacity: 0.035;\n      pointer-events: none;\n      z-index: 1;\n    }\n\n    /* Print-Specific Styles */\n    @media print {\n      body {\n        background: transparent;\n        padding: 0;\n      }\n      .controls {\n        display: none;\n      }\n      .certificate-container {\n        box-shadow: none;\n        width: 100%;\n        height: 100vh;\n        page-break-inside: avoid;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Screen Top Bar with Print Functionality & Role Selector -->\n  <div class=\"controls\">\n    <button class=\"role-btn active\" onclick=\"setRole('convener')\">Student Convener</button>\n    <button class=\"role-btn\" onclick=\"setRole('innovation')\">Innovation Coord.</button>\n    <button class=\"role-btn\" onclick=\"setRole('ipr')\">IPR Coord.</button>\n    <button class=\"role-btn\" onclick=\"setRole('startup')\">Startup Coord.</button>\n    <button class=\"role-btn\" onclick=\"setRole('social')\">Social Media Coord.</button>\n\n    <label class=\"upload-btn\" title=\"If you have your exact image files on disk, you can replace any logo instantly\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"17 8 12 3 7 8\"></polyline><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line></svg>\n      Replace with File\n      <input type=\"file\" id=\"logoUploader\" accept=\"image/*\" style=\"display: none;\" onchange=\"handleLogoUpload(event)\">\n    </label>\n\n    <button class=\"btn\" onclick=\"window.print()\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 6 2 18 2 18 9\"></polyline><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"></path><rect x=\"6\" y=\"14\" width=\"12\" height=\"8\"></rect></svg>\n      Print / Save PDF\n    </button>\n  </div>\n\n  <!-- A4 Certificate Area -->\n  <div class=\"certificate-container\" id=\"certificate\">\n    <!-- Ornate Borders and Corner Accents -->\n    <div class=\"border-outer\"></div>\n    <div class=\"border-middle\"></div>\n    <div class=\"border-inner\"></div>\n    <div class=\"corner corner-tl\"></div>\n    <div class=\"corner corner-tr\"></div>\n    <div class=\"corner corner-bl\"></div>\n    <div class=\"corner corner-br\"></div>\n\n    <!-- Center Watermark Crest -->\n    <svg class=\"watermark\" viewBox=\"0 0 200 200\" fill=\"currentColor\">\n      <circle cx=\"100\" cy=\"100\" r=\"90\" stroke=\"currentColor\" stroke-width=\"6\" fill=\"none\" />\n      <polygon points=\"100,20 120,75 180,80 135,120 150,180 100,145 50,180 65,120 20,80 80,75\" />\n    </svg>\n\n    <!-- 1. Top Logo Strip (Left completely blank for your direct manual placement) -->\n    <div class=\"logo-strip\" id=\"logoStrip\"></div>\n\n    <!-- 2. Institution Header & Certificate Type -->\n    <div class=\"header-section\">\n      <div class=\"college-name\">ACE Engineering College</div>\n      <div class=\"council-title\">Institution’s Innovation Council (IIC)</div>\n      <div class=\"cert-heading-wrap\">\n        <div class=\"cert-title\">Certificate of Appreciation</div>\n      </div>\n    </div>\n\n    <!-- 3. Body Content Area -->\n    <div class=\"body-section\">\n      <p class=\"presentation-line\">This Certificate is proudly presented to</p>\n\n      <div class=\"recipient-name-block\">\n        <div class=\"recipient-name\" contenteditable=\"true\" spellcheck=\"false\">[Student Full Name]</div>\n      </div>\n\n      <div class=\"recipient-role\" id=\"display-role\" contenteditable=\"true\">\n        Student Convener – Institution’s Innovation Council (IIC)\n      </div>\n\n      <p class=\"citation-text\" id=\"display-citation\">\n        In recognition of dedicated leadership, coordination, and valuable contribution to the activities and initiatives of the <strong>Institution’s Innovation Council</strong>, and for successfully supporting and coordinating the IIC student team during the <strong>one-year tenure</strong>. Your commitment and active involvement in promoting innovation, entrepreneurship, creativity, and student participation are sincerely appreciated.\n      </p>\n    </div>\n\n    <!-- 4. Certificate Metadata -->\n    <div class=\"meta-details\">\n      <div class=\"meta-item\">\n        <b>Duration:</b> <span>31 August 2025 to 31 August 2026</span>\n      </div>\n      <div class=\"meta-item\">\n        <b>Academic Year:</b> <span>2025–26</span>\n      </div>\n      <div class=\"meta-item\">\n        <b>Certificate No.:</b> <span contenteditable=\"true\" spellcheck=\"false\">ACE/IIC/2025-26/______</span>\n      </div>\n    </div>\n\n    <!-- 5. Central Official Seal -->\n    <div class=\"seal-wrap\">\n      <svg class=\"gold-seal-svg\" width=\"94\" height=\"116\" viewBox=\"0 0 120 148\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <!-- Rich radial gold gradient for seal body -->\n          <radialGradient id=\"gold-body\" cx=\"38%\" cy=\"32%\" r=\"68%\">\n            <stop offset=\"0%\" stop-color=\"#fff9e6\" />\n            <stop offset=\"22%\" stop-color=\"#fae18b\" />\n            <stop offset=\"58%\" stop-color=\"#d4af37\" />\n            <stop offset=\"85%\" stop-color=\"#a67715\" />\n            <stop offset=\"100%\" stop-color=\"#6e4905\" />\n          </radialGradient>\n          <!-- Ribbon Gradients -->\n          <linearGradient id=\"ribbon-l\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#e0b83f\" />\n            <stop offset=\"50%\" stop-color=\"#aa7914\" />\n            <stop offset=\"100%\" stop-color=\"#543603\" />\n          </linearGradient>\n          <linearGradient id=\"ribbon-r\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#fae18b\" />\n            <stop offset=\"50%\" stop-color=\"#b8861b\" />\n            <stop offset=\"100%\" stop-color=\"#543603\" />\n          </linearGradient>\n          <!-- Bevel Ring Gradient -->\n          <linearGradient id=\"ring-bevel\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#ffffff\" stop-opacity=\"0.9\" />\n            <stop offset=\"100%\" stop-color=\"#4a3002\" stop-opacity=\"0.8\" />\n          </linearGradient>\n        </defs>\n\n        <!-- Satin V-cut Ribbons -->\n        <g>\n          <!-- Left Ribbon tail -->\n          <path d=\"M 46 64 L 28 140 L 46 125 L 62 140 L 55 64 Z\" fill=\"url(#ribbon-l)\" />\n          <!-- Right Ribbon tail -->\n          <path d=\"M 65 64 L 58 140 L 74 125 L 92 140 L 74 64 Z\" fill=\"url(#ribbon-r)\" opacity=\"0.95\" />\n        </g>\n\n        <!-- Seal Medallion Body -->\n        <g>\n          <!-- Outer Scalloped / Fluted Rosette Rim (32 Points) -->\n          <path d=\"\n            M 60 6 \n            C 63 6, 65 8, 68 9 C 71 10, 74 10, 77 12 C 80 14, 82 16, 85 18 C 88 20, 91 21, 93 24 \n            C 95 27, 96 30, 98 33 C 100 36, 102 39, 103 42 C 104 46, 104 49, 104 53 C 104 57, 104 60, 103 64 \n            C 102 67, 100 70, 98 73 C 96 76, 95 79, 93 82 C 91 85, 88 86, 85 88 C 82 90, 80 92, 77 94 \n            C 74 96, 71 96, 68 97 C 65 98, 63 100, 60 100 C 57 100, 55 98, 52 97 C 49 96, 46 96, 43 94 \n            C 40 92, 38 90, 35 88 C 32 86, 29 85, 27 82 C 25 79, 24 76, 22 73 C 20 70, 18 67, 17 64 \n            C 16 60, 16 57, 16 53 C 16 49, 16 46, 17 42 C 18 39, 20 36, 22 33 C 24 30, 25 27, 27 24 \n            C 29 21, 32 20, 35 18 C 38 16, 40 14, 43 12 C 46 10, 49 10, 52 9 C 55 8, 57 6, 60 6 Z\n          \" fill=\"url(#gold-body)\" stroke=\"#784f07\" stroke-width=\"1.2\" />\n\n          <!-- Polished Bevel Inner Ring -->\n          <circle cx=\"60\" cy=\"53\" r=\"41\" fill=\"none\" stroke=\"url(#ring-bevel)\" stroke-width=\"1.8\" />\n\n          <!-- Stitched Concentric Border -->\n          <circle cx=\"60\" cy=\"53\" r=\"37\" fill=\"none\" stroke=\"#7a4f07\" stroke-width=\"1\" stroke-dasharray=\"2.5, 1.8\" opacity=\"0.85\" />\n          <circle cx=\"60\" cy=\"53\" r=\"34.5\" fill=\"none\" stroke=\"#ffeaa7\" stroke-width=\"0.7\" opacity=\"0.6\" />\n\n          <!-- Seal Typography & Heraldry Emblem -->\n          <!-- Header Curved Text -->\n          <text x=\"60\" y=\"36\" text-anchor=\"middle\" font-family=\"'Cinzel', serif\" font-size=\"6.5\" font-weight=\"800\" fill=\"#382103\" letter-spacing=\"1.2\">INSTITUTION'S</text>\n\n          <!-- Center Embellished Star -->\n          <polygon points=\"60,41.5 62.4,47 68.2,47.4 63.8,51.2 65.2,56.8 60,53.8 54.8,56.8 56.2,51.2 51.8,47.4 57.6,47\" fill=\"#382103\" />\n\n          <!-- Middle & Bottom Titles (Properly proportioned with zero clipping) -->\n          <text x=\"60\" y=\"66\" text-anchor=\"middle\" font-family=\"'Cinzel', serif\" font-size=\"6.8\" font-weight=\"800\" fill=\"#382103\" letter-spacing=\"1.1\">INNOVATION</text>\n          <text x=\"60\" y=\"75\" text-anchor=\"middle\" font-family=\"'Cinzel', serif\" font-size=\"6.2\" font-weight=\"800\" fill=\"#382103\" letter-spacing=\"1.4\">COUNCIL</text>\n\n          <!-- Bottom Micro Stars Accent -->\n          <text x=\"60\" y=\"83\" text-anchor=\"middle\" font-size=\"5\" fill=\"#663f04\" letter-spacing=\"2\">★ ★ ★</text>\n        </g>\n      </svg>\n    </div>\n\n    <!-- 6. Signatories (Student Convener & President) -->\n    <div class=\"signatures-section\">\n      <!-- Left Signatory: Student Convener -->\n      <div class=\"signature-block\">\n        <div class=\"sig-line\"></div>\n        <div class=\"sig-title\">Student Convener</div>\n        <div class=\"sig-org\">ACE Engineering College</div>\n      </div>\n\n      <!-- Right Signatory: President / Head of Institution -->\n      <div class=\"signature-block\">\n        <div class=\"sig-line\"></div>\n        <div class=\"sig-title\">President / Head of Institution</div>\n        <div class=\"sig-org\">ACE Engineering College</div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const roleData = {\n      convener: {\n        role: \"Student Convener – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated leadership, coordination, and valuable contribution to the activities and initiatives of the <strong>Institution’s Innovation Council</strong>, and for successfully supporting and coordinating the IIC student team during the <strong>one-year tenure</strong>. Your commitment and active involvement in promoting innovation, entrepreneurship, creativity, and student participation are sincerely appreciated.\"\n      },\n      startup: {\n        role: \"Startup Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, supporting activities related to entrepreneurship, startup awareness, ideation, innovation, and entrepreneurial engagement among students. Your active involvement and contribution towards developing an entrepreneurial mindset among students are sincerely appreciated.\"\n      },\n      innovation: {\n        role: \"Innovation Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, supporting initiatives that encouraged innovation, creativity, ideation, problem-solving, and student participation in innovation-oriented activities. Your enthusiasm and contribution towards fostering an innovation-driven environment are sincerely appreciated.\"\n      },\n      ipr: {\n        role: \"IPR Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, with active involvement in promoting awareness and understanding of Intellectual Property Rights, innovation, creativity, and knowledge protection among students. Your commitment and contribution towards strengthening the culture of innovation are sincerely appreciated.\"\n      },\n      social: {\n        role: \"Social Media Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, supporting the communication and digital promotion of IIC activities, events, initiatives, achievements, and student participation. Your consistent efforts in strengthening the digital presence and outreach of the Institution’s Innovation Council are sincerely appreciated.\"\n      }\n    };\n\n    function setRole(key) {\n      const data = roleData[key];\n      if (!data) return;\n      document.getElementById('display-role').innerHTML = data.role;\n      document.getElementById('display-citation').innerHTML = data.citation;\n\n      document.querySelectorAll('.role-btn').forEach(btn => btn.classList.remove('active'));\n      event.target.classList.add('active');\n    }\n  </script>\n</body>\n</html>","TargetFile":"C:\\Users\\prsnl\\.gemini\\antigravity\\brain\\d1b69639-1940-4d3a-9d7d-b4963cb4837c\\IIC_Certificate_Generator.html","toolAction":"Saving the HTML Certificate Generator to the artifacts directory","toolSummary":"Save Certificate HTML"}}]}
{"step_index":1439,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-18T11:55:45Z","thinking":"**Prioritizing Specific Tools**\n\nI'm focusing on the importance of selecting the most appropriate tool for each task. The goal is to maximize efficiency. I am making an active effort to ensure that I always choose the correct approach to each problem or challenge, such as choosing a relevant 'view_file' utility where possible.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Interactive HTML Certificate Generator for IIC Coordinators, allowing instant selection of roles and printing capabilities.","UserFacing":true},"CodeContent":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Certificate of Appreciation - ACE Engineering College IIC</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Alex+Brush&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --primary-navy: #0b1a30;\n      --deep-navy: #050d18;\n      --gold-main: #c59b27;\n      --gold-light: #f3df8a;\n      --gold-dark: #8c6814;\n      --accent-slate: #475569;\n      --text-dark: #1e293b;\n      --bg-cream: #faf9f6;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: #334155;\n      font-family: 'Montserrat', sans-serif;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 30px 15px;\n      color: var(--text-dark);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    /* Print & Action Controls Bar */\n    .controls {\n      display: flex;\n      gap: 12px;\n      margin-bottom: 20px;\n      align-items: center;\n      flex-wrap: wrap;\n      justify-content: center;\n    }\n\n    .role-btn {\n      background: #1e293b;\n      color: #e2e8f0;\n      border: 1px solid #475569;\n      padding: 8px 14px;\n      font-size: 12px;\n      font-weight: 600;\n      border-radius: 6px;\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n\n    .role-btn:hover, .role-btn.active {\n      background: linear-gradient(135deg, #d4af37, #aa8214);\n      color: #0b1a30;\n      border-color: #d4af37;\n      font-weight: 700;\n    }\n\n    .btn {\n      background: linear-gradient(135deg, #d4af37, #aa8214);\n      color: #0b1a30;\n      border: none;\n      padding: 10px 22px;\n      font-size: 13px;\n      font-weight: 700;\n      letter-spacing: 0.8px;\n      text-transform: uppercase;\n      border-radius: 6px;\n      cursor: pointer;\n      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);\n      transition: all 0.2s ease;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .btn:hover {\n      background: linear-gradient(135deg, #e5c158, #bd941c);\n      transform: translateY(-2px);\n      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);\n    }\n\n    .upload-btn {\n      background: #0f172a;\n      color: #94a3b8;\n      border: 1px dashed #64748b;\n      padding: 8px 12px;\n      font-size: 11px;\n      font-weight: 600;\n      border-radius: 6px;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      transition: all 0.2s;\n    }\n    .upload-btn:hover {\n      color: #f1f5f9;\n      border-color: #cbd5e1;\n    }\n\n    /* Certificate Dimensions: Standard A4 Landscape (297mm x 210mm) */\n    .certificate-container {\n      width: 1050px;\n      height: 742px;\n      background: var(--bg-cream);\n      position: relative;\n      box-shadow: 0 15px 45px rgba(0, 0, 0, 0.45);\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      padding: 30px 44px;\n      background-image: \n        radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.96), rgba(248, 246, 240, 0.92)),\n        radial-gradient(circle, rgba(197, 155, 39, 0.04) 1px, transparent 1px);\n      background-size: 100% 100%, 24px 24px;\n    }\n\n    /* Multi-layered Gold and Navy Borders */\n    .border-outer {\n      position: absolute;\n      inset: 12px;\n      border: 3px solid var(--gold-main);\n      pointer-events: none;\n    }\n\n    .border-middle {\n      position: absolute;\n      inset: 18px;\n      border: 1px dashed var(--gold-dark);\n      pointer-events: none;\n    }\n\n    .border-inner {\n      position: absolute;\n      inset: 24px;\n      border: 1px solid rgba(11, 26, 48, 0.2);\n      pointer-events: none;\n    }\n\n    /* Corner Luxury Accents */\n    .corner {\n      position: absolute;\n      width: 44px;\n      height: 44px;\n      border-color: var(--gold-main);\n      pointer-events: none;\n    }\n    .corner-tl { top: 18px; left: 18px; border-top: 5px solid var(--gold-main); border-left: 5px solid var(--gold-main); }\n    .corner-tr { top: 18px; right: 18px; border-top: 5px solid var(--gold-main); border-right: 5px solid var(--gold-main); }\n    .corner-bl { bottom: 18px; left: 18px; border-bottom: 5px solid var(--gold-main); border-left: 5px solid var(--gold-main); }\n    .corner-br { bottom: 18px; right: 18px; border-bottom: 5px solid var(--gold-main); border-right: 5px solid var(--gold-main); }\n\n    /* Top Logo Strip */\n    .logo-strip {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding-bottom: 10px;\n      border-bottom: 1.5px solid rgba(197, 155, 39, 0.35);\n      position: relative;\n      z-index: 2;\n      gap: 12px;\n      min-height: 70px;\n      height: 70px;\n    }\n\n    /* Header Typography */\n    .header-section {\n      text-align: center;\n      margin-top: 4px;\n      position: relative;\n      z-index: 2;\n    }\n\n    .college-name {\n      font-family: 'Cinzel', serif;\n      font-size: 24px;\n      font-weight: 800;\n      letter-spacing: 2px;\n      color: var(--primary-navy);\n      text-transform: uppercase;\n      margin-bottom: 3px;\n    }\n\n    .council-title {\n      font-family: 'Montserrat', sans-serif;\n      font-size: 13.5px;\n      font-weight: 700;\n      letter-spacing: 3px;\n      color: var(--gold-dark);\n      text-transform: uppercase;\n      margin-bottom: 12px;\n    }\n\n    .cert-heading-wrap {\n      display: inline-block;\n      position: relative;\n      padding: 0 20px;\n    }\n\n    .cert-title {\n      font-family: 'Cinzel', serif;\n      font-size: 25px;\n      font-weight: 700;\n      color: var(--primary-navy);\n      letter-spacing: 4px;\n      text-transform: uppercase;\n      display: inline-block;\n      border-bottom: 2px solid var(--gold-main);\n      padding-bottom: 4px;\n    }\n\n    /* Certificate Body */\n    .body-section {\n      text-align: center;\n      margin: 8px 0;\n      position: relative;\n      z-index: 2;\n    }\n\n    .presentation-line {\n      font-family: 'Playfair Display', serif;\n      font-style: italic;\n      font-size: 15px;\n      color: var(--accent-slate);\n      margin-bottom: 8px;\n    }\n\n    .recipient-name-block {\n      margin: 8px auto 6px auto;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .recipient-name {\n      font-family: 'Playfair Display', Georgia, serif;\n      font-size: 32px;\n      font-weight: 700;\n      color: var(--primary-navy);\n      min-width: 480px;\n      border-bottom: 1.5px solid var(--gold-main);\n      padding-bottom: 4px;\n      letter-spacing: 0.5px;\n      outline: none;\n    }\n\n    .recipient-role {\n      font-family: 'Cinzel', serif;\n      font-size: 15px;\n      font-weight: 700;\n      color: var(--gold-dark);\n      letter-spacing: 1.5px;\n      margin-top: 10px;\n      text-transform: uppercase;\n    }\n\n    .citation-text {\n      max-width: 820px;\n      margin: 10px auto 0 auto;\n      font-size: 12px;\n      line-height: 1.65;\n      color: #334155;\n      font-weight: 400;\n      text-align: center;\n    }\n\n    .citation-text strong {\n      color: var(--primary-navy);\n      font-weight: 600;\n    }\n\n    /* Details Metadata */\n    .meta-details {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      max-width: 900px;\n      width: 100%;\n      margin: 12px auto 18px auto;\n      font-size: 11.5px;\n      color: #334155;\n      font-weight: 500;\n      padding: 6px 16px;\n      background: rgba(255, 255, 255, 0.65);\n      border-radius: 6px;\n      border: 1px solid rgba(197, 155, 39, 0.25);\n    }\n\n    .meta-item {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      white-space: nowrap;\n    }\n\n    .meta-details b {\n      color: var(--primary-navy);\n      font-weight: 700;\n    }\n\n    /* Central Gold Seal */\n    .seal-wrap {\n      position: absolute;\n      bottom: 22px;\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      z-index: 3;\n      pointer-events: none;\n    }\n\n    .gold-seal-svg {\n      display: block;\n      filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.28));\n    }\n\n    /* Signatures Section */\n    .signatures-section {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      padding: 0 40px;\n      margin-top: 14px;\n      position: relative;\n      z-index: 2;\n    }\n\n    .signature-block {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      width: 250px;\n      text-align: center;\n    }\n\n    .sig-line {\n      width: 100%;\n      border-bottom: 1.5px solid #0f172a;\n      margin-bottom: 6px;\n    }\n\n    .sig-title {\n      font-family: 'Montserrat', sans-serif;\n      font-size: 12px;\n      font-weight: 700;\n      color: var(--primary-navy);\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    .sig-org {\n      font-size: 10.5px;\n      font-weight: 500;\n      color: #475569;\n      margin-top: 2px;\n    }\n\n    /* Subtle Center Watermark */\n    .watermark {\n      position: absolute;\n      top: 52%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      width: 320px;\n      height: 320px;\n      opacity: 0.035;\n      pointer-events: none;\n      z-index: 1;\n    }\n\n    /* Print-Specific Styles */\n    @media print {\n      body {\n        background: transparent;\n        padding: 0;\n      }\n      .controls {\n        display: none;\n      }\n      .certificate-container {\n        box-shadow: none;\n        width: 100%;\n        height: 100vh;\n        page-break-inside: avoid;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Screen Top Bar with Print Functionality & Role Selector -->\n  <div class=\"controls\">\n    <button class=\"role-btn active\" onclick=\"setRole('convener')\">Student Convener</button>\n    <button class=\"role-btn\" onclick=\"setRole('innovation')\">Innovation Coord.</button>\n    <button class=\"role-btn\" onclick=\"setRole('ipr')\">IPR Coord.</button>\n    <button class=\"role-btn\" onclick=\"setRole('startup')\">Startup Coord.</button>\n    <button class=\"role-btn\" onclick=\"setRole('social')\">Social Media Coord.</button>\n\n    <label class=\"upload-btn\" title=\"If you have your exact image files on disk, you can replace any logo instantly\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"17 8 12 3 7 8\"></polyline><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line></svg>\n      Replace with File\n      <input type=\"file\" id=\"logoUploader\" accept=\"image/*\" style=\"display: none;\" onchange=\"handleLogoUpload(event)\">\n    </label>\n\n    <button class=\"btn\" onclick=\"window.print()\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 6 2 18 2 18 9\"></polyline><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"></path><rect x=\"6\" y=\"14\" width=\"12\" height=\"8\"></rect></svg>\n      Print / Save PDF\n    </button>\n  </div>\n\n  <!-- A4 Certificate Area -->\n  <div class=\"certificate-container\" id=\"certificate\">\n    <!-- Ornate Borders and Corner Accents -->\n    <div class=\"border-outer\"></div>\n    <div class=\"border-middle\"></div>\n    <div class=\"border-inner\"></div>\n    <div class=\"corner corner-tl\"></div>\n    <div class=\"corner corner-tr\"></div>\n    <div class=\"corner corner-bl\"></div>\n    <div class=\"corner corner-br\"></div>\n\n    <!-- Center Watermark Crest -->\n    <svg class=\"watermark\" viewBox=\"0 0 200 200\" fill=\"currentColor\">\n      <circle cx=\"100\" cy=\"100\" r=\"90\" stroke=\"currentColor\" stroke-width=\"6\" fill=\"none\" />\n      <polygon points=\"100,20 120,75 180,80 135,120 150,180 100,145 50,180 65,120 20,80 80,75\" />\n    </svg>\n\n    <!-- 1. Top Logo Strip (Left completely blank for your direct manual placement) -->\n    <div class=\"logo-strip\" id=\"logoStrip\"></div>\n\n    <!-- 2. Institution Header & Certificate Type -->\n    <div class=\"header-section\">\n      <div class=\"college-name\">ACE Engineering College</div>\n      <div class=\"council-title\">Institution’s Innovation Council (IIC)</div>\n      <div class=\"cert-heading-wrap\">\n        <div class=\"cert-title\">Certificate of Appreciation</div>\n      </div>\n    </div>\n\n    <!-- 3. Body Content Area -->\n    <div class=\"body-section\">\n      <p class=\"presentation-line\">This Certificate is proudly presented to</p>\n\n      <div class=\"recipient-name-block\">\n        <div class=\"recipient-name\" contenteditable=\"true\" spellcheck=\"false\">[Student Full Name]</div>\n      </div>\n\n      <div class=\"recipient-role\" id=\"display-role\" contenteditable=\"true\">\n        Student Convener – Institution’s Innovation Council (IIC)\n      </div>\n\n      <p class=\"citation-text\" id=\"display-citation\">\n        In recognition of dedicated leadership, coordination, and valuable contribution to the activities and initiatives of the <strong>Institution’s Innovation Council</strong>, and for successfully supporting and coordinating the IIC student team during the <strong>one-year tenure</strong>. Your commitment and active involvement in promoting innovation, entrepreneurship, creativity, and student participation are sincerely appreciated.\n      </p>\n    </div>\n\n    <!-- 4. Certificate Metadata -->\n    <div class=\"meta-details\">\n      <div class=\"meta-item\">\n        <b>Duration:</b> <span>31 August 2025 to 31 August 2026</span>\n      </div>\n      <div class=\"meta-item\">\n        <b>Academic Year:</b> <span>2025–26</span>\n      </div>\n      <div class=\"meta-item\">\n        <b>Certificate No.:</b> <span contenteditable=\"true\" spellcheck=\"false\">ACE/IIC/2025-26/______</span>\n      </div>\n    </div>\n\n    <!-- 5. Central Official Seal -->\n    <div class=\"seal-wrap\">\n      <svg class=\"gold-seal-svg\" width=\"94\" height=\"116\" viewBox=\"0 0 120 148\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <!-- Rich radial gold gradient for seal body -->\n          <radialGradient id=\"gold-body\" cx=\"38%\" cy=\"32%\" r=\"68%\">\n            <stop offset=\"0%\" stop-color=\"#fff9e6\" />\n            <stop offset=\"22%\" stop-color=\"#fae18b\" />\n            <stop offset=\"58%\" stop-color=\"#d4af37\" />\n            <stop offset=\"85%\" stop-color=\"#a67715\" />\n            <stop offset=\"100%\" stop-color=\"#6e4905\" />\n          </radial.Gradient>\n          <!-- Ribbon Gradients -->\n          <linearGradient id=\"ribbon-l\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#e0b83f\" />\n            <stop offset=\"50%\" stop-color=\"#aa7914\" />\n            <stop offset=\"100%\" stop-color=\"#543603\" />\n          </linearGradient>\n          <linearGradient id=\"ribbon-r\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#fae18b\" />\n            <stop offset=\"50%\" stop-color=\"#b8861b\" />\n            <stop offset=\"100%\" stop-color=\"#543603\" />\n          </linearGradient>\n          <!-- Bevel Ring Gradient -->\n          <linearGradient id=\"ring-bevel\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#ffffff\" stop-opacity=\"0.9\" />\n            <stop offset=\"100%\" stop-color=\"#4a3002\" stop-opacity=\"0.8\" />\n          </linearGradient>\n        </defs>\n\n        <!-- Satin V-cut Ribbons -->\n        <g>\n          <!-- Left Ribbon tail -->\n          <path d=\"M 46 64 L 28 140 L 46 125 L 62 140 L 55 64 Z\" fill=\"url(#ribbon-l)\" />\n          <!-- Right Ribbon tail -->\n          <path d=\"M 65 64 L 58 140 L 74 125 L 92 140 L 74 64 Z\" fill=\"url(#ribbon-r)\" opacity=\"0.95\" />\n        </g>\n\n        <!-- Seal Medallion Body -->\n        <g>\n          <!-- Outer Scalloped / Fluted Rosette Rim (32 Points) -->\n          <path d=\"\n            M 60 6 \n            C 63 6, 65 8, 68 9 C 71 10, 74 10, 77 12 C 80 14, 82 16, 85 18 C 88 20, 91 21, 93 24 \n            C 95 27, 96 30, 98 33 C 100 36, 102 39, 103 42 C 104 46, 104 49, 104 53 C 104 57, 104 60, 103 64 \n            C 102 67, 100 70, 98 73 C 96 76, 95 79, 93 82 C 91 85, 88 86, 85 88 C 82 90, 80 92, 77 94 \n            C 74 96, 71 96, 68 97 C 65 98, 63 100, 60 100 C 57 100, 55 98, 52 97 C 49 96, 46 96, 43 94 \n            C 40 92, 38 90, 35 88 C 32 86, 29 85, 27 82 C 25 79, 24 76, 22 73 C 20 70, 18 67, 17 64 \n            C 16 60, 16 57, 16 53 C 16 49, 16 46, 17 42 C 18 39, 20 36, 22 33 C 24 30, 25 27, 27 24 \n            C 29 21, 32 20, 35 18 C 38 16, 40 14, 43 12 C 46 10, 49 10, 52 9 C 55 8, 57 6, 60 6 Z\n          \" fill=\"url(#gold-body)\" stroke=\"#784f07\" stroke-width=\"1.2\" />\n\n          <!-- Polished Bevel Inner Ring -->\n          <circle cx=\"60\" cy=\"53\" r=\"41\" fill=\"none\" stroke=\"url(#ring-bevel)\" stroke-width=\"1.8\" />\n\n          <!-- Stitched Concentric Border -->\n          <circle cx=\"60\" cy=\"53\" r=\"37\" fill=\"none\" stroke=\"#7a4f07\" stroke-width=\"1\" stroke-dasharray=\"2.5, 1.8\" opacity=\"0.85\" />\n          <circle cx=\"60\" cy=\"53\" r=\"34.5\" fill=\"none\" stroke=\"#ffeaa7\" stroke-width=\"0.7\" opacity=\"0.6\" />\n\n          <!-- Seal Typography & Heraldry Emblem -->\n          <!-- Header Curved Text -->\n          <text x=\"60\" y=\"36\" text-anchor=\"middle\" font-family=\"'Cinzel', serif\" font-size=\"6.5\" font-weight=\"800\" fill=\"#382103\" letter-spacing=\"1.2\">INSTITUTION'S</text>\n\n          <!-- Center Embellished Star -->\n          <polygon points=\"60,41.5 62.4,47 68.2,47.4 63.8,51.2 65.2,56.8 60,53.8 54.8,56.8 56.2,51.2 51.8,47.4 57.6,47\" fill=\"#382103\" />\n\n          <!-- Middle & Bottom Titles (Properly proportioned with zero clipping) -->\n          <text x=\"60\" y=\"66\" text-anchor=\"middle\" font-family=\"'Cinzel', serif\" font-size=\"6.8\" font-weight=\"800\" fill=\"#382103\" letter-spacing=\"1.1\">INNOVATION</text>\n          <text x=\"60\" y=\"75\" text-anchor=\"middle\" font-family=\"'Cinzel', serif\" font-size=\"6.2\" font-weight=\"800\" fill=\"#382103\" letter-spacing=\"1.4\">COUNCIL</text>\n\n          <!-- Bottom Micro Stars Accent -->\n          <text x=\"60\" y=\"83\" text-anchor=\"middle\" font-size=\"5\" fill=\"#663f04\" letter-spacing=\"2\">★ ★ ★</text>\n        </g>\n      </svg>\n    </div>\n\n    <!-- 6. Signatories (Student Convener & President) -->\n    <div class=\"signatures-section\">\n      <!-- Left Signatory: Student Convener -->\n      <div class=\"signature-block\">\n        <div class=\"sig-line\"></div>\n        <div class=\"sig-title\">Student Convener</div>\n        <div class=\"sig-org\">ACE Engineering College</div>\n      </div>\n\n      <!-- Right Signatory: President / Head of Institution -->\n      <div class=\"signature-block\">\n        <div class=\"sig-line\"></div>\n        <div class=\"sig-title\">President / Head of Institution</div>\n        <div class=\"sig-org\">ACE Engineering College</div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const roleData = {\n      convener: {\n        role: \"Student Convener – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated leadership, coordination, and valuable contribution to the activities and initiatives of the <strong>Institution’s Innovation Council</strong>, and for successfully supporting and coordinating the IIC student team during the <strong>one-year tenure</strong>. Your commitment and active involvement in promoting innovation, entrepreneurship, creativity, and student participation are sincerely appreciated.\"\n      },\n      startup: {\n        role: \"Startup Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, supporting activities related to entrepreneurship, startup awareness, ideation, innovation, and entrepreneurial engagement among students. Your active involvement and contribution towards developing an entrepreneurial mindset among students are sincerely appreciated.\"\n      },\n      innovation: {\n        role: \"Innovation Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, supporting initiatives that encouraged innovation, creativity, ideation, problem-solving, and student participation in innovation-oriented activities. Your enthusiasm and contribution towards fostering an innovation-driven environment are sincerely appreciated.\"\n      },\n      ipr: {\n        role: \"IPR Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, with active involvement in promoting awareness and understanding of Intellectual Property Rights, innovation, creativity, and knowledge protection among students. Your commitment and contribution towards strengthening the culture of innovation are sincerely appreciated.\"\n      },\n      social: {\n        role: \"Social Media Coordinator – Institution’s Innovation Council (IIC)\",\n        citation: \"In recognition of dedicated service and valuable contribution to the <strong>Institution’s Innovation Council</strong> during the <strong>one-year tenure</strong>, supporting the communication and digital promotion of IIC activities, events, initiatives, achievements, and student participation. Your consistent efforts in strengthening the digital presence and outreach of the Institution’s Innovation Council are sincerely appreciated.\"\n      }\n    };\n\n    function setRole(key) {\n      const data = roleData[key];\n      if (!data) return;\n      document.getElementById('display-role').innerHTML = data.role;\n      document.getElementById('display-citation').innerHTML = data.citation;\n\n      document.querySelectorAll('.role-btn').forEach(btn => btn.classList.remove('active'));\n      event.target.classList.add('active');\n    }\n  </script>\n</body>\n</html>","Description":"Saved the interactive HTML Certificate Generator.","Overwrite":true,"TargetFile":"C:\\Users\\prsnl\\.gemini\\antigravity\\brain\\d1b69639-1940-4d3a-9d7d-b4963cb4837c\\IIC_Certificate_Generator.html","toolAction":"Saving the HTML Certificate Generator to the artifacts directory","toolSummary":"Save Certificate HTML"}}]}
